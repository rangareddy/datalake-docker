# Compose loads this file automatically because it sits next to the compose files.

# ---------------------------------------------------------------------------- tag
# Every image in this stack carries one tag, and it is the tag of the stack, not of
# the component inside it. rangareddy1988/ranga-spark:1.0.0, ranga-kafka:1.0.0,
# ranga-hive:1.0.0 - all of them.
#
# Which versions of Spark, Kafka, Hive and the rest 1.0.0 is made of is recorded in
# the "Versions" table in README.md, and in the defaults at the top of
# docker_build/build_docker_images.sh. Upgrading a component does not change any image
# name; it produces a different 1.0.0 until someone decides the change is worth a new
# stack version, at which point this line and that table move together.
IMAGE_VERSION=1.0.0

# --------------------------------------------------------------------- spark line
# This does not form a tag. It selects which of the two Spark images the stack starts,
# because the two lines carry different connectors:
#
#   3.5.9 -> ranga-spark    Hudi, Iceberg and Delta
#   4.1.3 -> ranga-spark4   Iceberg only
#
# run_datalake.sh derives SPARK_IMAGE from it, so switching lines is this one line:
#   SPARK_VERSION=4.1.3 sh run_datalake.sh restart
#
# The matching image has to have been built: build with the same SPARK_VERSION.
SPARK_VERSION=3.5.9

# ------------------------------------------------------------------------ platform
# Detected from the Docker daemon by run_datalake.sh and by build_docker_images.sh, so
# Apple Silicon builds and runs arm64 natively and Intel amd64, with nothing to edit
# here. Uncomment only to force a cross-platform build.
# PLATFORM=linux/amd64
