# Version pins for the Compose stack.
#
# Compose loads this file automatically because it sits next to the compose files.
# Keep these in sync with the defaults in docker_build/build_docker_images.sh: the
# build script tags every image it produces with both <version> and "latest", so a
# pin here only resolves if that version was actually built.
#
# Override per-invocation instead of editing, e.g.:
#   SPARK_VERSION=3.5.3 sh run_datalake.sh restart

# Locally built images (docker_build/build_docker_images.sh)
HIVE_VERSION=4.0.0
SPARK_VERSION=3.5.5
KAFKA_CONNECT_VERSION=7.4.7
CONFLUENT_KAFKACAT_VERSION=7.1.15

# Locally built images, only used by the "all" profile.
TRINO_VERSION=483
XTABLE_VERSION=0.3.0
FLINK_VERSION=1.20.5
JUPYTER_VERSION=latest

# Upstream images
#
# MinIO is pulled from quay.io, not Docker Hub: the docker.io/minio/minio repository
# no longer resolves ("pull access denied"), and quay.io is where MinIO publishes.
MINIO_VERSION=latest
MINIO_MC_VERSION=latest
CONFLUENT_VERSION=7.4.7
KAFKA_UI_VERSION=latest
POSTGRES_VERSION=16.4
MYSQL_VERSION=8.0-20.04_edge
CLOUDBEAVER_VERSION=latest

# Build/run platform. Set to linux/arm64 on Apple Silicon to avoid emulation.
PLATFORM=linux/amd64
